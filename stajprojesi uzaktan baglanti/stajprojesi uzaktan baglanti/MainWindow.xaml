<Window x:Class="stajprojesi_uzaktan_baglanti.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteDesk | Uzaktan Baglanti" Height="760" Width="940"

        MinHeight="740" MinWidth="820" WindowStartupLocation="CenterScreen"
        Background="#F4F6FA" FontFamily="Segoe UI" Foreground="#17243B">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#315DE6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#69768B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
    </Window.Resources>
    <Grid Margin="36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Border DockPanel.Dock="Right" Background="#E7EBF2" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                <TextBlock x:Name="SunucuDurumText" Text="Sunucu bagli degil" Foreground="#657187" FontSize="12"/>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Border Background="#315DE6" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                    <TextBlock Text="R" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="RemoteDesk" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,30,0,24">
            <TextBlock Text="Uzakta olsan da, kontrol sende." FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="Bu bilgisayara erisim ver veya baska bir bilgisayara baglan." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
            <Label Content="Sunucu adresi" Target="{Binding ElementName=SunucuAdresTextBox}" Margin="0,12,0,0"/>
            <DockPanel><Button x:Name="SunucuBaglanButton" DockPanel.Dock="Right" Content="Sunucuya baglan" Click="PencereYuklendi" Margin="10,0,0,0"/><TextBox x:Name="SunucuAdresTextBox" Text="wss://localhost:7007/ws" VerticalContentAlignment="Center" Padding="10" FontSize="15"/></DockPanel>
            <CheckBox x:Name="YerelTestCheckBox" Content="Sifresiz yerel test baglantisina izin ver (yalnizca guvendigin ozel agda)" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E1E6EF" BorderThickness="1" CornerRadius="16" Padding="26">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="BU BILGISAYAR" Foreground="#315DE6" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Baglanti al" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,8"/>
                        <TextBlock Text="Kodunu karsi tarafla paylas. Erisim, sen onay verdiginde baslasin." Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18">
                        <TextBlock Text="Senin baglanti kodun" FontSize="12" Foreground="#69768B" Margin="0,0,0,9"/>
                        <Border Background="#F4F6FA" CornerRadius="9" Padding="14" MinHeight="54">
                            <TextBlock x:Name="KendiKodumTextBlock" Text="Henuz kod olusturulmadi" Foreground="#69768B" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Row="2" Content="Baglanti Al" Click="BaglantiAl_Click"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E1E6EF" BorderThickness="1" CornerRadius="16" Padding="26">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="UZAK BILGISAYAR" Foreground="#315DE6" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Baglan" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,8"/>
                        <TextBlock Text="Kontrol etmek istedigin bilgisayarin baglanti kodunu gir." Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18">
                        <Label Content="Karsi bilgisayarin kodu" Target="{Binding ElementName=BaglantiKoduTextBox}" Padding="0" FontSize="12" Foreground="#69768B" Margin="0,0,0,9"/>
                        <TextBox x:Name="BaglantiKoduTextBox" Height="54" Padding="12,0" VerticalContentAlignment="Center" FontSize="22" Background="White" BorderBrush="#BAC7DF" BorderThickness="1" AutomationProperties.Name="Karsi bilgisayarin baglanti kodu"/>
                    </StackPanel>
                    <Button Grid.Row="2" Content="Baglan" Click="Baglan_Click"/>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="DurumText" Text="Sunucu adresini girip baglan." Style="{StaticResource Hint}" HorizontalAlignment="Center"/><Button x:Name="KontrolButton" Content="Fare ve klavye kontrolune izin ver" Click="Kontrol_Click" Visibility="Collapsed" Height="36" Margin="0,8,0,0"/><Button x:Name="DurdurButton" Content="Paylasimi / izlemeyi durdur" Click="Durdur_Click" Visibility="Collapsed" Background="#B42318" Height="36" Margin="0,8,0,0"/></StackPanel>
    </Grid>
</Window>



